# Supabase proje ayarları (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# SADECE sunucuda kullanılır, asla NEXT_PUBLIC_ ile başlatma
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# PixelLab görsel üretimi (portre ve arma). Yoksa sade SVG görseller kullanılır.
# Anahtar: pixellab.ai hesap sayfası. SADECE sunucuda, NEXT_PUBLIC_ ile başlatma.
PIXELLAB_API_KEY=

# İsteğe bağlı: borsa fiyat tohumu (yoksa service role anahtarından türetilir).
# Yayına aldıktan sonra DEĞİŞTİRME, tüm fiyat geçmişi değişir.
# MARKET_SEED=uzun-rastgele-bir-metin


# Web bildirimleri (push). Anahtar üretmek için: npx web-push generate-vapid-keys
# Public key tarayıcıya gider (NEXT_PUBLIC_), private key SADECE sunucuda.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:senin@epostan.com
# Zamanlayıcının (Supabase pg_cron) /api/cron/push çağrısı için gizli değer; 014 göçündeki ile aynı olmalı
CRON_SECRET=
